# Cerebro conversacional: anthropic (Claude) u openai. El proyecto queda en Claude.
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# Voz OpenAI: la misma clave sirve para transcribir y sintetizar voz.
OPENAI_API_KEY=
OPENAI_STT_MODEL=gpt-transcribe
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=marin

# Solo se usa si LLM_PROVIDER=openai.
OPENAI_CHAT_MODEL=gpt-5.4-mini

PORT=8787
